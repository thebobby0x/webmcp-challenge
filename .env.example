# Gemini API Key — get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud project (for Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1

# Model — gemini-2.0-flash is fastest, gemini-2.5-pro for max capability
GEMINI_MODEL=gemini-2.0-flash

# Model used by the /architect endpoint (singularityLab Fleet Architect).
# Kept separate from GEMINI_MODEL so the ADK fleet agents and the architect
# layer can move independently. ARCHITECT_FALLBACK_MODEL is tried if the
# primary is briefly unavailable; set it to "" to disable the fallback.
ARCHITECT_MODEL=gemini-3.6-flash
ARCHITECT_FALLBACK_MODEL=gemini-flash-latest

# Event config
EVENT_NAME=IMEX America 2026
EVENT_DATE=2026-10-12
